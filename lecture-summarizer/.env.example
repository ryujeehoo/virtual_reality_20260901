# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 절대 커밋하지 마세요.

# https://build.nvidia.com 에서 모델 하나 고르고 "Get API Key" 를 누르면 나옵니다.
NVIDIA_API_KEY=nvapi-여기에_본인_키

# 요약에 쓸 모델 (build.nvidia.com 카탈로그의 이름 그대로)
LECSUM_LLM_MODEL=meta/llama-3.3-70b-instruct

# 음성인식 설정
LECSUM_ASR_BACKEND=whisper       # whisper(로컬) | openai(클라우드)
LECSUM_WHISPER_MODEL=large-v3    # 느리면 medium 이나 small 로
LECSUM_WHISPER_DEVICE=auto       # auto | cpu | cuda
LECSUM_LANGUAGE=ko

# LECSUM_ASR_BACKEND=openai 일 때만
# LECSUM_ASR_BASE_URL=https://api.example.com/v1
# LECSUM_ASR_API_KEY=
# LECSUM_ASR_MODEL=whisper-1

LECSUM_OUTDIR=out
